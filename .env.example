# Copia este archivo como .env y cambia los valores.
# El archivo .env NUNCA se sube al repositorio.

# PostgreSQL
POSTGRES_DB=rutaia
POSTGRES_USER=rutaia
POSTGRES_PASSWORD=cambia_esta_clave

# n8n: clave para cifrar las credenciales guardadas (cualquier texto largo y aleatorio)
N8N_ENCRYPTION_KEY=cambia_esta_clave_larga_y_aleatoria

# OpenRouter (se usara mas adelante; en n8n se configura como credencial)
OPENROUTER_API_KEY=tu_api_key_aqui
